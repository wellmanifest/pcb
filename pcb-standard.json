{
  "schema_id": "wellmanifest.pcb/standard/v1",
  "id": "wellmanifest/pcb",
  "version": "1.8.0",
  "title": "PCB & Schematic Style Contract Standard",
  "status": "canonical",
  "standardOwner": "wellmanifest",
  "placement": {
    "home": "wellmanifest",
    "shape": "domain_pack",
    "adopt": "wellmanifest/pcb"
  },
  "grammar": {
    "profile_schema": "wellmanifest.pcb/style/v1",
    "report_schema": "wellmanifest.pcb/style-report/v1",
    "comparison_schema": "wellmanifest.pcb/style-comparison/v1",
    "sources": [
      ".kicad_pcb",
      ".kicad_sch"
    ],
    "discovery": [
      "$WELLMANIFEST_PCB_PROFILE",
      "<artifacts>/.wellmanifest/pcb.json",
      "<adopter>/profiles/wellmanifest-pcb.v1.json"
    ],
    "merge": "per-field override on top of the default profile; unknown rule id is an error",
    "context_schema": "wellmanifest.pcb/context/v1",
    "baseline_schema": "wellmanifest.pcb/style-baseline/v1",
    "baseline_discovery": [
      "$WELLMANIFEST_PCB_BASELINE",
      "<artifacts>/.wellmanifest/pcb-baseline.json"
    ],
    "operations_schema": "wellmanifest.pcb/operations/v1"
  },
  "scopes": [
    "pcb",
    "schematic",
    "project"
  ],
  "severities": [
    "blocking",
    "advisory",
    "off"
  ],
  "rules": [
    {
      "id": "RULE_LAYER_STACKUP",
      "scope": "pcb",
      "default_severity": "blocking",
      "measures": "liczbę i nazwy warstw miedzi wobec zamówionego procesu"
    },
    {
      "id": "RULE_NO_COPPER_UNDER_PART",
      "scope": "pcb",
      "default_severity": "blocking",
      "measures": "obcą miedź pod obrysem elementu z metalem dociskanym do laminatu"
    },
    {
      "id": "RULE_SILK_OVER_PAD",
      "scope": "pcb",
      "default_severity": "advisory",
      "measures": "linie sitodruku wchodzące na otwór w masce pada"
    },
    {
      "id": "RULE_ZONE_LAYER_ALLOWLIST",
      "scope": "pcb",
      "default_severity": "blocking",
      "measures": "strefy miedzi poza warstwami dopuszczonymi przez profil"
    },
    {
      "id": "RULE_TRACK_WIDTH_MIN",
      "scope": "pcb",
      "default_severity": "blocking",
      "measures": "segmenty węższe niż proces producenta"
    },
    {
      "id": "RULE_TRACK_WIDTH_MAX",
      "scope": "pcb",
      "default_severity": "blocking",
      "measures": "segmenty szersze niż górny limit profilu"
    },
    {
      "id": "RULE_TRACK_WIDTH_BY_NET",
      "scope": "pcb",
      "default_severity": "blocking",
      "measures": "szerokość ścieżki wobec progu klasy sieci, do której należy"
    },
    {
      "id": "RULE_COORDINATE_GRID",
      "scope": "pcb",
      "default_severity": "blocking",
      "measures": "raster minimalny — najdrobniejszy dopuszczalny krok współrzędnych"
    },
    {
      "id": "RULE_TRACK_GRID",
      "scope": "pcb",
      "default_severity": "advisory",
      "measures": "końce ścieżek poza rastrem trasowania"
    },
    {
      "id": "RULE_TRACK_ANGLE",
      "scope": "pcb",
      "default_severity": "advisory",
      "measures": "kąty prowadzenia ścieżek spoza dozwolonego zbioru"
    },
    {
      "id": "RULE_FOOTPRINT_GRID",
      "scope": "pcb",
      "default_severity": "advisory",
      "measures": "elementy poza rastrem montażowym i dozwolonymi obrotami"
    },
    {
      "id": "RULE_REFERENCE_NAMING",
      "scope": "pcb",
      "default_severity": "advisory",
      "measures": "oznaczenia elementów poza konwencją litera+numer"
    },
    {
      "id": "RULE_PIN_WIRE_GAP",
      "scope": "schematic",
      "default_severity": "blocking",
      "measures": "koniec przewodu mijający punkt połączenia pinu"
    },
    {
      "id": "RULE_RAIL_LABEL_CANONICAL",
      "scope": "schematic",
      "default_severity": "blocking",
      "measures": "szynę zasilania zapisaną pod kilkoma nazwami"
    },
    {
      "id": "RULE_SIGNAL_LABEL_NAMING",
      "scope": "schematic",
      "default_severity": "advisory",
      "measures": "etykiety sygnałów poza konwencją nazewniczą"
    },
    {
      "id": "RULE_SCH_PCB_NET_PARITY",
      "scope": "project",
      "default_severity": "blocking",
      "measures": "ten sam pin z różną siecią w schemacie i w PCB"
    },
    {
      "id": "RULE_SCH_PCB_FOOTPRINT_PARITY",
      "scope": "project",
      "default_severity": "blocking",
      "measures": "rozjazd między footprintem zadeklarowanym w schemacie a użytym na płytce"
    },
    {
      "id": "RULE_POWER_DECOUPLING",
      "scope": "project",
      "default_severity": "advisory",
      "measures": "szynę zasilania bez ani jednego kondensatora do masy"
    }
  ],
  "gates": {
    "candidate_regression": {
      "rule": "kandydat nie może zwiększyć liczby naruszeń reguły blocking wobec źródła",
      "codes": [
        "EDA_STYLE_REGRESSION",
        "EDA_STYLE_NOT_RUN"
      ],
      "inherited_debt": "naruszenie obecne po obu stronach nie blokuje decyzji"
    },
    "source_debt_baseline": {
      "rule": "baseline nie zmienia profilu ani liczby naruszeń; CI blokuje wzrost reguły blocking ponad jawnie zaakceptowany limit, a tryb strict blokuje wzrost każdej reguły",
      "profile_binding": "id, version, name i SHA-256 efektywnego profilu muszą się zgadzać; niezgodność lub nieczytelny baseline blokuje",
      "identity": "pełna ścieżka względna pliku, nigdy sama nazwa",
      "acceptance": "dokument wymaga accepted.by, accepted.at i accepted.reason",
      "unknown_policy": "nieznany plik lub identyfikator reguły jest błędem, nie cichym pominięciem"
    },
    "ordering": [
      "profil wyglądu (ten pakiet)",
      "DRC KiCad",
      "audyt łączności / ERC",
      "decyzja człowieka",
      "promocja źródła"
    ],
    "net_parity": {
      "rule": "pin obecny po obu stronach musi mieć tę samą sieć; brak netlisty to brak kontroli",
      "codes": [
        "EDA_PARITY_MISMATCH",
        "EDA_PARITY_NOT_RUN"
      ],
      "requires": "kicad-cli (eksport netlisty schematu)"
    }
  },
  "context": {
    "schema": "wellmanifest.pcb/context/v1",
    "discovery": [
      "$WELLMANIFEST_CONTEXT",
      "<artifacts>/.wellmanifest/context.json"
    ],
    "answers": [
      "co plik zawiera i kiedy go zmieniać (z trybem zmiany)",
      "jakie są zależności między plikami",
      "która strona ma pierwszeństwo przy sprzeczności i dlaczego"
    ],
    "roles": [
      "firmware",
      "eda",
      "cad",
      "render",
      "documentation",
      "source"
    ],
    "edit_modes": [
      "manual",
      "twinstudio-candidate",
      "manual-or-twinstudio",
      "generated"
    ],
    "dependency_kinds": [
      "generates",
      "documents",
      "netlist-parity",
      "renders",
      "derives"
    ],
    "resolution": "propose-only: konflikt dostaje propozycję z uzasadnieniem, decyzję podejmuje człowiek; plik spoza kolejności daje decidable:false",
    "validation": "zależność albo pozycja kolejności wskazująca plik nieopisany w files jest błędem manifestu"
  },
  "adopters": [
    {
      "id": "maskservice/viewer",
      "role": "walidator i bramka",
      "bindings": {
        "cli": "scripts/pcbctl.py {profile|check|diff|parity}",
        "make": "make style",
        "http": [
          "/api/eda/style-profile",
          "/api/eda/style-report/{rel}",
          "/api/eda/parity/{rel}",
          "/api/eda/capabilities",
          "/api/project-context/manifest"
        ],
        "gate": "_refuse_if_gated → akceptacja, decyzja i promocja kandydata",
        "local_extension": "<artifacts>/.wellmanifest/pcb.json",
        "local_context": "<artifacts>/.wellmanifest/context.json"
      }
    },
    {
      "id": "digitaltwin-run/twinstudio",
      "role": "właściciel zapisu i strumienia zdarzeń",
      "bindings": {
        "dsl": "twinstudio.eda-change/v1",
        "cli": "twinstudio eda {inspect|plan|check|apply|shell}",
        "status": "profil czytany przez adoptera; natywne wiązanie w kicad_dsl planowane"
      }
    }
  ],
  "propose_only": true,
  "operations": [
    {
      "id": "set_track_width",
      "scope": "pcb",
      "entity": "segment",
      "changes": "copper",
      "clears": [
        "RULE_TRACK_WIDTH_BY_NET",
        "RULE_TRACK_WIDTH_MIN"
      ],
      "verify": [
        "drc_no_regression",
        "style_no_regression"
      ],
      "reversible": true,
      "why": "Odcinek węższy niż klasa jego sieci nie uniesie prądu, dla którego klasa powstała."
    },
    {
      "id": "orthogonalize_track",
      "scope": "pcb",
      "entity": "segment",
      "changes": "copper",
      "clears": [
        "RULE_TRACK_ANGLE"
      ],
      "verify": [
        "drc_no_regression",
        "style_no_regression"
      ],
      "reversible": true,
      "why": "Skos bez powodu utrudnia kontrolę wzrokową i produkcję szablonu."
    },
    {
      "id": "reroute_component_nets",
      "scope": "pcb",
      "entity": "track",
      "changes": "copper",
      "clears": [
        "RULE_TRACK_GRID",
        "RULE_TRACK_ANGLE",
        "RULE_TRACK_WIDTH_BY_NET",
        "RULE_NO_COPPER_UNDER_PART"
      ],
      "verify": [
        "drc_no_regression",
        "style_no_regression",
        "net_parity"
      ],
      "reversible": true,
      "why": "Przestawiony element unieważnia każdą trasę, która do niego dochodziła; doklejanie mostków zamienia jedną zmianę w dług."
    },
    {
      "id": "route_power_net",
      "scope": "pcb",
      "entity": "segment",
      "changes": "copper",
      "clears": [],
      "verify": [
        "drc_no_regression",
        "net_parity"
      ],
      "reversible": true,
      "why": "Szyna zasilania poprowadzona jawnie zamiast polegania na wylaniu strefy."
    },
    {
      "id": "assign_pad_net",
      "scope": "pcb",
      "entity": "pad",
      "changes": "netlist",
      "clears": [
        "RULE_SCH_PCB_NET_PARITY"
      ],
      "verify": [
        "net_parity",
        "drc_no_regression"
      ],
      "reversible": true,
      "why": "Pad bez sieci albo z cudzą siecią to rozjazd wobec schematu."
    },
    {
      "id": "move",
      "scope": "pcb",
      "entity": "footprint",
      "changes": "placement",
      "clears": [
        "RULE_FOOTPRINT_GRID"
      ],
      "verify": [
        "drc_no_regression",
        "style_no_regression"
      ],
      "reversible": true,
      "why": "Pozycja elementu jest wejściem dla trasowania i dla obudowy."
    },
    {
      "id": "trim_silkscreen",
      "scope": "pcb",
      "entity": "fp_line",
      "changes": "silkscreen",
      "clears": [
        "RULE_SILK_OVER_PAD"
      ],
      "verify": [
        "drc_no_regression"
      ],
      "reversible": true,
      "why": "Farba na odsłoniętej miedzi nie zostaje po montażu, a jej resztki fałszują odczyt."
    },
    {
      "id": "fill_zones",
      "scope": "pcb",
      "entity": "zone",
      "changes": "copper",
      "clears": [],
      "verify": [
        "drc_no_regression"
      ],
      "reversible": true,
      "why": "Strefa bez wyliczonej miedzi nie daje potwierdzonego połączenia."
    },
    {
      "id": "remove_zones",
      "scope": "pcb",
      "entity": "zone",
      "changes": "copper",
      "clears": [],
      "verify": [
        "drc_no_regression",
        "net_parity"
      ],
      "reversible": true,
      "why": "Świadome usunięcie strefy porzuconej — decyzja, nie zaniechanie."
    },
    {
      "id": "add_decoupling_capacitor",
      "scope": "project",
      "entity": "component",
      "changes": "bom",
      "clears": [
        "RULE_POWER_DECOUPLING"
      ],
      "verify": [
        "drc_no_regression",
        "net_parity",
        "footprint_parity"
      ],
      "reversible": false,
      "why": "Szyna bez kondensatora do masy nie daje objawu ani w netliście, ani w DRC."
    },
    {
      "id": "set_property",
      "scope": "schematic",
      "entity": "symbol",
      "changes": "metadata",
      "clears": [],
      "verify": [],
      "reversible": true,
      "why": "Wartość, oznaczenie i opis to dane, nie geometria."
    },
    {
      "id": "set_footprint_field",
      "scope": "schematic",
      "entity": "symbol",
      "changes": "metadata",
      "clears": [
        "RULE_SCH_PCB_FOOTPRINT_PARITY"
      ],
      "verify": [
        "footprint_parity"
      ],
      "reversible": true,
      "why": "Pole Footprint w schemacie potrafi wskazywać inny element niż leży na płytce."
    },
    {
      "id": "mark_no_connect",
      "scope": "schematic",
      "entity": "pin",
      "changes": "netlist",
      "clears": [],
      "verify": [
        "connectivity_preserved"
      ],
      "reversible": true,
      "why": "Pin świadomie niepodłączony różni się od zapomnianego tylko tym znacznikiem."
    },
    {
      "id": "merge_split_rails",
      "scope": "schematic",
      "entity": "label",
      "changes": "netlist",
      "clears": [],
      "verify": [
        "connectivity_preserved",
        "net_parity"
      ],
      "reversible": true,
      "why": "Dwie nazwy tej samej szyny dzielą ją na dwie sieci, których nikt nie zamawiał."
    },
    {
      "id": "split_wire_at_tap",
      "scope": "schematic",
      "entity": "wire",
      "changes": "netlist",
      "clears": [],
      "verify": [
        "connectivity_preserved"
      ],
      "reversible": true,
      "why": "Odgałęzienie w środku przewodu bez węzła nie łączy."
    },
    {
      "id": "synchronize_net_connectivity",
      "scope": "project",
      "entity": "net",
      "changes": "netlist",
      "clears": [
        "RULE_SCH_PCB_NET_PARITY"
      ],
      "verify": [
        "net_parity",
        "connectivity_preserved"
      ],
      "reversible": true,
      "why": "Rozjazd sieci między schematem a płytką nie należy do żadnego z tych plików z osobna."
    }
  ],
  "changes": [
    {
      "id": "copper",
      "why": "Miedź: ścieżki, przelotki, strefy. Wymaga DRC."
    },
    {
      "id": "placement",
      "why": "Pozycja elementu. Wejście dla trasowania i obudowy."
    },
    {
      "id": "silkscreen",
      "why": "Warstwy opisowe. Nie zmienia łączności."
    },
    {
      "id": "netlist",
      "why": "Co jest z czym połączone. Wymaga porównania netlisty."
    },
    {
      "id": "metadata",
      "why": "Dane elementu bez geometrii."
    },
    {
      "id": "bom",
      "why": "Dokłada albo usuwa element. Zmienia listę zakupów."
    }
  ],
  "verifications": [
    {
      "id": "drc_no_regression",
      "why": "Kandydat nie zwiększa liczby naruszeń DRC w żadnej kategorii."
    },
    {
      "id": "style_no_regression",
      "why": "Kandydat nie zwiększa liczby naruszeń reguły blocking."
    },
    {
      "id": "net_parity",
      "why": "Sieci schematu i płytki zgadzają się pin po pinie."
    },
    {
      "id": "footprint_parity",
      "why": "Schemat i płytka mówią o tym samym footprincie."
    },
    {
      "id": "connectivity_preserved",
      "why": "Netlista po zmianie jest identyczna co do węzła."
    }
  ]
}
