{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/pcb/component-catalog.schema.v1.json",
  "title": "wellmanifest.pcb/component-catalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "version", "sources", "manifests"],
  "properties": {
    "schema_id": {"const": "wellmanifest.pcb/component-catalog/v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sources": {"type": "string", "minLength": 1},
    "manifests": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_component_min_status", "legacy_statuses"],
      "properties": {
        "new_component_min_status": {"const": "qualified"},
        "legacy_statuses": {
          "type": "array",
          "items": {"enum": ["quarantined", "provisional", "deprecated"]},
          "uniqueItems": true
        }
      }
    }
  }
}
