{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/pcb/design-intent.schema.v1.json",
  "title": "wellmanifest PCB human-owned design intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "version",
    "title",
    "artifacts",
    "delegated_parameters"
  ],
  "properties": {
    "schema_id": {"const": "wellmanifest.pcb/design-intent/v1"},
    "version": {"const": "1.0.0"},
    "title": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "updated_by": {"type": "string", "minLength": 1},
    "source_sha256_at_decision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "delegated_parameters": {
      "type": "array",
      "items": {"$ref": "#/$defs/delegated_parameter"}
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {"pattern": "^[^/].*\\.kicad_pcb$"},
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "delegated_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "policy", "rule", "description"],
      "properties": {
        "parameter": {"type": "string", "minLength": 1},
        "policy": {"enum": ["fixed", "range", "allowed", "editable"]},
        "rule": {"type": "string", "pattern": "^RULE_[A-Z0-9_]+$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "components": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
          "additionalProperties": {"$ref": "#/$defs/component"}
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "orientation", "footprint", "reason"],
      "properties": {
        "position": {"$ref": "#/$defs/position"},
        "orientation": {"$ref": "#/$defs/orientation"},
        "footprint": {"$ref": "#/$defs/footprint"},
        "reason": {"type": "string", "maxLength": 2000}
      }
    },
    "position": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "x_mm", "y_mm", "tolerance_mm"],
          "properties": {
            "policy": {"const": "fixed"},
            "x_mm": {"type": "number"},
            "y_mm": {"type": "number"},
            "tolerance_mm": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "x_min_mm", "x_max_mm", "y_min_mm", "y_max_mm"],
          "properties": {
            "policy": {"const": "bounded"},
            "x_min_mm": {"type": "number"},
            "x_max_mm": {"type": "number"},
            "y_min_mm": {"type": "number"},
            "y_max_mm": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {"policy": {"const": "editable"}}
        }
      ]
    },
    "orientation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "deg", "tolerance_deg"],
          "properties": {
            "policy": {"const": "fixed"},
            "deg": {"type": "number"},
            "tolerance_deg": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "values_deg"],
          "properties": {
            "policy": {"const": "allowed"},
            "values_deg": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "number"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {"policy": {"const": "editable"}}
        }
      ]
    },
    "footprint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "value"],
          "properties": {
            "policy": {"const": "fixed"},
            "value": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {"policy": {"const": "editable"}}
        }
      ]
    }
  }
}
