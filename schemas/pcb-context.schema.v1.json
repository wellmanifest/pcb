{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/pcb/context.v1.json",
  "title": "wellmanifest.pcb/context/v1",
  "description": "Zadeklarowany kontekst projektu: co zawiera plik i kiedy go zmieniać, jakie są zależności między plikami oraz która strona ma pierwszeństwo przy sprzeczności. Manifest niczego nie rozstrzyga sam — dostarcza propozycję do decyzji człowieka.",
  "type": "object",
  "required": ["schema_id", "files"],
  "additionalProperties": false,
  "properties": {
    "schema_id": {"const": "wellmanifest.pcb/context/v1"},
    "project": {"type": "string"},
    "title": {"type": "string"},
    "source": {"type": "string"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "description": "Ścieżka względem katalogu artefaktów; dopuszczalny wzorzec glob."},
          "role": {"enum": ["firmware", "eda", "cad", "render", "documentation", "source"]},
          "contains": {"type": "string"},
          "change_when": {"type": "string"},
          "edit": {"enum": ["manual", "twinstudio-candidate", "manual-or-twinstudio", "generated"]},
          "authoritative_for": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "kind": {"enum": ["generates", "documents", "netlist-parity", "renders", "derives"]},
          "note": {"type": "string"}
        }
      }
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "order"],
        "additionalProperties": false,
        "properties": {
          "subject": {"type": "string"},
          "order": {"type": "array", "minItems": 1, "items": {"type": "string"},
                    "description": "Od najwyższego autorytetu do najniższego; każda pozycja musi być opisana w files."},
          "why": {"type": "string"}
        }
      }
    }
  }
}
