{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/pcb/style.v1.json",
  "title": "wellmanifest.pcb/style/v1",
  "description": "Deklaratywny profil wyglądu płytki i schematu. Słownik reguł jest zamknięty: nieznana nazwa reguły to błąd profilu, nie cicha zmiana zachowania.",
  "type": "object",
  "required": [
    "schema_id"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "wellmanifest.pcb/style/v1"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "via_cost": {
          "type": "number",
          "minimum": 0
        },
        "via_cost_by_net": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "net_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "RULE_NO_COPPER_UNDER_PART": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "shielded_pattern": {
              "type": "string",
              "format": "regex"
            }
          }
        },
        "RULE_COMPONENT_EDGE_CLEARANCE": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "min_mm": {
              "type": "number",
              "minimum": 2.54
            },
            "exceptions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reference", "reason"],
                "properties": {
                  "reference": {"type": "string", "minLength": 1},
                  "reason": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "RULE_CONNECTOR_COURTYARD_MARGIN": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "connector_pattern": {
              "type": "string",
              "format": "regex"
            },
            "margin_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "RULE_CONNECTOR_EDGE_CLEARANCE": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "connector_pattern": {
              "type": "string",
              "format": "regex"
            },
            "edge_mount_references": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "min_mm": {
              "type": "number",
              "minimum": 2.54
            }
          }
        },
        "RULE_CONNECTOR_PAD_EDGE_CLEARANCE": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "connector_pattern": {
              "type": "string",
              "format": "regex"
            },
            "edge_mount_references": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "min_mm": {
              "type": "number",
              "minimum": 2.54
            }
          }
        },
        "RULE_TRACK_EDGE_CLEARANCE": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "min_mm": {
              "type": "number",
              "minimum": 2.54
            }
          }
        },
        "RULE_VIA_EDGE_CLEARANCE": {
          "allOf": [
            {"$ref": "#/$defs/rule"}
          ],
          "properties": {
            "min_mm": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "RULE_TRACK_NET_CLEARANCE": {
          "allOf": [
            {"$ref": "#/$defs/rule"}
          ],
          "properties": {
            "min_mm": {"type": "number", "minimum": 0}
          }
        },
        "RULE_TRACK_COPPER_MARGIN": {
          "allOf": [
            {"$ref": "#/$defs/rule"}
          ],
          "properties": {
            "min_mm": {"type": "number", "minimum": 0}
          }
        },
        "RULE_EDGE_MOUNT_CONNECTOR_ALIGNMENT": {
          "allOf": [
            {"$ref": "#/$defs/rule"}
          ],
          "properties": {
            "connectors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["reference", "edge", "max_body_gap_mm", "min_copper_edge_mm"],
                "additionalProperties": false,
                "properties": {
                  "reference": {"type": "string", "minLength": 1},
                  "edge": {"enum": ["left", "right", "top", "bottom"]},
                  "max_body_gap_mm": {"type": "number", "minimum": 0},
                  "min_copper_edge_mm": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        },
        "RULE_BUS_TRANSIT": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "net_pattern": {
              "type": "string",
              "format": "regex"
            },
            "part_pattern": {
              "type": "string",
              "format": "regex"
            },
            "max_transits": {
              "type": "integer",
              "minimum": 0
            },
            "endpoint_tolerance_mm": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "RULE_FOOTPRINT_INTERNAL_CONNECTIVITY": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "part_pattern",
                  "terminal_groups"
                ],
                "additionalProperties": false,
                "properties": {
                  "part_pattern": {
                    "type": "string",
                    "format": "regex"
                  },
                  "terminal_groups": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "require_distinct_groups": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "RULE_VIA_BUDGET": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "net_pattern": {
              "type": "string",
              "format": "regex"
            },
            "max_total": {
              "type": "integer",
              "minimum": 0
            },
            "max_per_net": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "RULE_VIA_IN_PAD": {
          "allOf": [
            {"$ref": "#/$defs/rule"}
          ],
          "properties": {
            "include_annulus_overlap": {"type": "boolean"},
            "exceptions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["reference", "process"],
                "additionalProperties": false,
                "properties": {
                  "reference": {"type": "string", "minLength": 1},
                  "pad": {"type": "string", "minLength": 1},
                  "process": {"enum": ["filled-and-capped", "via-in-pad-plated-over"]},
                  "reason": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "RULE_ZONE_LAYER_ALLOWLIST": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "layers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "RULE_TRACK_WIDTH_MIN": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "min_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "RULE_FOOTPRINT_GRID": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "grid_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rotations_deg": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "RULE_REFERENCE_NAMING": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "format": "regex"
            }
          }
        },
        "RULE_RAIL_LABEL_CANONICAL": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "format": "regex"
            },
            "require_prefix": {
              "type": "string",
              "maxLength": 4
            }
          }
        },
        "RULE_SIGNAL_LABEL_NAMING": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "format": "regex"
            }
          }
        },
        "RULE_LAYER_STACKUP": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "layers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          }
        },
        "RULE_TRACK_WIDTH_MAX": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "max_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "RULE_COORDINATE_GRID": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "min_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "RULE_TRACK_GRID": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "grid_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "RULE_TRACK_ANGLE": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "angles_deg": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "RULE_PIN_WIRE_GAP": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "max_gap_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "RULE_SCH_PCB_NET_PARITY": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {}
        },
        "RULE_TRACK_WIDTH_BY_NET": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "classes": {
              "type": "array",
              "minItems": 1,
              "description": "Klasy sieci od najbardziej szczegółowej; pierwsza pasująca rozstrzyga.",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "net_pattern",
                  "min_mm"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "net_pattern": {
                    "type": "string",
                    "format": "regex"
                  },
                  "min_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        "RULE_POWER_DECOUPLING": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "rail_pattern": {
              "type": "string",
              "format": "regex"
            },
            "ground_net": {
              "type": "string"
            },
            "min_capacitors": {
              "type": "integer",
              "minimum": 1
            },
            "min_rail_nodes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "RULE_SILK_OVER_PAD": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ],
          "properties": {
            "mask_margin_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_segment_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "RULE_SCH_PCB_FOOTPRINT_PARITY": {
          "allOf": [
            {
              "$ref": "#/$defs/rule"
            }
          ]
        }
      }
    },
    "repairs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zone_fill_clears": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "blocking",
            "advisory",
            "off"
          ]
        },
        "scope": {
          "enum": [
            "pcb",
            "schematic",
            "project"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
